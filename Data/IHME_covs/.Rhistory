problem_names <- c(
"British Virgin Islands",
"Cayman Islands",
"Faroe Islands",
"French Polynesia",
"Gibraltar",
"Hong Kong SAR, China",
"Kosovo",
"Liechtenstein",
"Macao SAR, China",
"Curaçao",
"Aruba",
"Sint Maarten (Dutch part)",
"New Caledonia",
"St. Martin (French part)",
"Turks and Caicos Islands",
"Isle of Man"
)
location_data |>
filter(
grepl(
paste(problem_names, collapse = "|"),
location_name,
ignore.case = TRUE
)
) |>
select(location_id, location_name, level, parent_id, sort_order) |>
arrange(location_name)
gbd_locations |>
filter(
grepl("Hong|Macao|Virgin|Cayman|Faroe|French Polynesia|Gibraltar|Kosovo|Liechtenstein|Curacao|Aruba|Sint|Martin|Turks|Man",
location_name,
ignore.case = TRUE)
) |>
select(location_id, location_name, level, parent_id)
location_data |>
filter(
grepl("Hong|Macao|Virgin|Cayman|Faroe|French Polynesia|Gibraltar|Kosovo|Liechtenstein|Curacao|Aruba|Sint|Martin|Turks|Man",
location_name,
ignore.case = TRUE)
) |>
select(location_id, location_name, level, parent_id)
